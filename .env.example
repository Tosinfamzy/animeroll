# Local SQLite (dev). Vercel + Turso uses libsql://...turso.io?authToken=...
DATABASE_URL=file:./local.db

# Optional. Required for hosted Turso (not used for local file:).
DATABASE_AUTH_TOKEN=

# Used in shareable link generation. Set to the deployed origin in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Clerk (auth) ---
# Provision with `clerk init` or grab from dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Route mapping for the auth UI.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Rate limiting (Upstash Redis / Vercel KV) ---
# Optional locally (an in-memory fallback is used for `next dev`), but REQUIRED
# in production: without these every limiter degrades to a per-invocation no-op
# on serverless. The app logs an error on a prod boot with no store; set
# RATE_LIMIT_REQUIRE_REDIS=1 to hard-fail the deploy instead. Provision via the
# Vercel "Upstash for Redis" marketplace integration (injects KV_REST_API_*) or
# a direct Upstash setup (UPSTASH_REDIS_REST_*). Either pair is accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_REQUIRE_REDIS=1

# --- Playwright (authed E2E) ---
# Required for tests/e2e/share-loop.spec.ts. Create two users in your Clerk
# dev instance (email+password strategy) and put their creds here. Without
# these the authed spec is skipped.
E2E_CLERK_USER_A_EMAIL=
E2E_CLERK_USER_A_PASSWORD=
E2E_CLERK_USER_B_EMAIL=
E2E_CLERK_USER_B_PASSWORD=
